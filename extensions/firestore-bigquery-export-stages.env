BIGQUERY_PROJECT_ID=forusbots
CLUSTERING=timestamp,document_id
COLLECTION_PATH=jobs/{jobId}/stages
DATABASE=(default)
DATABASE_REGION=us-central1
DATASET_ID=forusbots_analytics
DATASET_LOCATION=us-central1
EXCLUDE_OLD_DATA=no
firebaseextensions.v1beta.function/location=us-central1
LOG_LEVEL=info
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
TABLE_ID=stages
TABLE_PARTITIONING=DAY
TIME_PARTITIONING_FIELD_TYPE=omit
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
VIEW_TYPE=view
WILDCARD_IDS=true
